  <diagram id="ai-feedback-workflow" name="Quy trình phân nhóm phản hồi khách hàng">
    <mxGraphModel dx="1400" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1600" math="0" shadow="1">
      <root>
