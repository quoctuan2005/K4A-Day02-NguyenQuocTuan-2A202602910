<mxfile host="app.diagrams.net" modified="2026-09-12T13:00:00.000Z" agent="Mozilla/5.0" version="24.7.17">
  <diagram id="feedback-workflow" name="Customer Feedback Clustering">
    <mxGraphModel dx="1200" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1400" math="0" shadow="1">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- TITLE -->
        <mxCell id="title" value="CUSTOMER FEEDBACK CLUSTERING — CURRENT WORKFLOW" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#172033;" vertex="1" parent="1">
          <mxGeometry x="180" y="30" width="900" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="subtitle" value="PM manually turns hundreds of raw feedback items into actionable pain points" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=14;fontColor=#667085;" vertex="1" parent="1">
          <mxGeometry x="250" y="75" width="760" height="30" as="geometry"/>
        </mxCell>

        <!-- STEP 1 -->
        <mxCell id="step1" value="&lt;b&gt;1. COLLECT FEEDBACK&lt;/b&gt;&lt;br&gt;&lt;br&gt;💬 Slack &nbsp;&nbsp; 🎧 Support&lt;br&gt;📝 Interview notes &nbsp;&nbsp; 📞 Calls" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FF;strokeColor=#4C8BF5;strokeWidth=2;fontSize=16;fontColor=#172033;align=center;verticalAlign=middle;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="140" width="660" height="130" as="geometry"/>
        </mxCell>

        <!-- Arrow -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#98A2B3;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="step1" target="step2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- STEP 2 -->
        <mxCell id="step2" value="&lt;b&gt;2. READ + UNDERSTAND&lt;/b&gt;&lt;br&gt;&lt;br&gt;PM đọc từng feedback&lt;br&gt;để hiểu context + intent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C5CFC;strokeWidth=2;fontSize=16;fontColor=#172033;align=center;verticalAlign=middle;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="320" width="660" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#98A2B3;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="step2" target="step3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- STEP 3 -->
        <mxCell id="step3" value="&lt;b&gt;3. TAG / CATEGORIZE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Gán category / topic cho từng feedback&lt;br&gt;→ tạo context để so sánh" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF3;strokeColor=#32A66B;strokeWidth=2;fontSize=16;fontColor=#172033;align=center;verticalAlign=middle;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="500" width="660" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#98A2B3;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="step3" target="step4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- BOTTLENECK 1 -->
        <mxCell id="bottleneck1" value="⚠ BOTTLENECK #1&lt;br&gt;&lt;b&gt;High cognitive load&lt;/b&gt;&lt;br&gt;PM phải đọc và so sánh thủ công" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#F59E0B;strokeWidth=2;fontSize=14;fontColor=#9A6700;align=center;verticalAlign=middle;spacing=8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1020" y="500" width="260" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="b1link" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#F59E0B;strokeWidth=2;dashed=1;endArrow=none;" edge="1" parent="1" source="bottleneck1" target="step3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- STEP 4 -->
        <mxCell id="step4" value="&lt;b&gt;4. COMPARE SIMILAR FEEDBACK&lt;/b&gt;&lt;br&gt;&lt;br&gt;&quot;slow checkout&quot;&lt;br&gt;&quot;checkout takes forever&quot;&lt;br&gt;&quot;payment page hangs&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F97316;strokeWidth=3;fontSize=16;fontColor=#172033;align=center;verticalAlign=middle;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="680" width="660" height="170" as="geometry"/>
        </mxCell>

        <!-- Bottleneck badge -->
        <mxCell id="badge4" value="BOTTLENECK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DC2626;strokeColor=#B91C1C;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="660" width="140" height="35" as="geometry"/>
        </mxCell>

        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#98A2B3;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="step4" target="step5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- STEP 5 -->
        <mxCell id="step5" value="&lt;b&gt;5. MERGE INTO PAIN POINT&lt;/b&gt;&lt;br&gt;&lt;br&gt;Có cùng underlying problem không?&lt;br&gt;&lt;br&gt;3 feedback → &lt;b&gt;&quot;Checkout is too slow&quot;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;strokeWidth=3;fontSize=16;fontColor=#172033;align=center;verticalAlign=middle;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="900" width="660" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="badge5" value="BOTTLENECK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DC2626;strokeColor=#B91C1C;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="880" width="140" height="35" as="geometry"/>
        </mxCell>

        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#98A2B3;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="step5" target="step6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- STEP 6 -->
        <mxCell id="step6" value="&lt;b&gt;6. NAME + DESCRIBE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Đặt tên theme&lt;br&gt;Viết mô tả underlying pain point" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#0EA5E9;strokeWidth=2;fontSize=16;fontColor=#172033;align=center;verticalAlign=middle;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="1100" width="660" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#98A2B3;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="step6" target="step7">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- STEP 7 -->
        <mxCell id="step7" value="&lt;b&gt;7. REVIEW&lt;/b&gt;&lt;br&gt;&lt;br&gt;🔀 Merge &nbsp;&nbsp; ✂ Split &nbsp;&nbsp; ✏ Rename&lt;br&gt;&lt;br&gt;PM kiểm tra lại toàn bộ themes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#475467;strokeWidth=2;fontSize=16;fontColor=#172033;align=center;verticalAlign=middle;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="1280" width="660" height="140" as="geometry"/>
        </mxCell>

        <!-- Feedback volume indicator -->
        <mxCell id="volume" value="📚 HUNDREDS OF FEEDBACK ITEMS&lt;br&gt;↓&lt;br&gt;👤 1 PM&lt;br&gt;↓&lt;br&gt;🧠 MANUAL CLUSTERING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#172033;strokeColor=#172033;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="680" width="230" height="170" as="geometry"/>
        </mxCell>

        <mxCell id="volLink" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#667085;strokeWidth=2;dashed=1;endArrow=none;" edge="1" parent="1" source="volume" target="step4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Time / effort -->
        <mxCell id="effort" value="⏱ REPEATED EVERY WEEK&lt;br&gt;&lt;br&gt;Manual work accumulates&lt;br&gt;as feedback volume grows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#FB7185;strokeWidth=2;fontColor=#9F1239;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;spacing=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1020" y="900" width="260" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="effortLink" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#FB7185;strokeWidth=2;dashed=1;endArrow=none;" edge="1" parent="1" source="effort" target="step5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Bottom impact -->
        <mxCell id="impact" value="CURRENT STATE&lt;br&gt;&lt;b&gt;Collect → Read → Tag → Compare → Merge → Name → Review&lt;/b&gt;&lt;br&gt;&lt;br&gt;⚠ Repetitive &nbsp;&nbsp; ⚠ Manual &nbsp;&nbsp; ⚠ Cognitive-heavy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAECF0;strokeColor=#667085;strokeWidth=2;fontSize=15;fontColor=#172033;align=center;verticalAlign=middle;spacing=10;shadow=1;" vertex="1" parent="1">
